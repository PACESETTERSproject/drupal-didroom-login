# Public URL of the issuer, without a trailing slash: wallets and verifiers
# reach it there. scripts/dev-issuer.sh sets it to the tunnel URL. After a
# change: ./configure.sh, then docker compose restart.
ISSUER_URL=http://localhost:8091
# Name shown in wallets and in the emails.
ISSUER_NAME="Pacesetters email issuer"
# Port on 127.0.0.1 where the proxy listens.
ISSUER_PORT=8091

# Mail server for the codes. The defaults deliver to the Mailpit container
# of the dev profile (web UI on http://127.0.0.1:8027, or MAILPIT_PORT).
MAIL_FROM="Pacesetters email issuer <no-reply@example.org>"
SMTP_HOST=mailpit
SMTP_PORT=1025
# starttls, tls or none.
SMTP_SECURITY=none
SMTP_USER=
SMTP_PASSWORD=
